# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Replace these with your actual Supabase project credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# Student AI Provider Configuration (Backend Only - Never expose to frontend)
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
AI_DAILY_MESSAGE_LIMIT=50
AI_MAX_CONTEXT_TOKENS=4000
AI_REQUEST_TIMEOUT_MS=30000
